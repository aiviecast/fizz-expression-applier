// wasm — ブラウザの表情適用から呼ぶ。
//   ex_clamp(v) -> Float: 値クランプ [0,1]。
//   emotion 名を ex_in_alloc で線形メモリに書く → ex_resolve() が channel JSON を
//   出力バッファに書いて長さを返す → ex_out_ptr() で読み取り JSON.parse。
//   JS は各 channel を setMorphOrExpression(n, ex_clamp(w * weight)) で適用する。
// almide#440 対策で main から全 export を参照。
import self as ex
import bytes
import float
import int
import list
import string

var g_in: Bytes = bytes.zeros(0)
var g_out: Bytes = bytes.zeros(0)

@export(wasm, "ex_clamp")
fn ex_clamp(v: Float) -> Float = ex.clamp01(v)

@export(wasm, "ex_in_alloc")
fn ex_in_alloc(len: Float) -> RawPtr = {
  g_in = bytes.zeros(int.from_saturating(len))
  bytes.as_mut_ptr(g_in)
}

@export(wasm, "ex_resolve")
fn ex_resolve() -> Float = {
  let s = ex.channels_json(bytes.to_string_lossy(g_in))
  g_out = bytes.from_string(s)
  // 実バイト長を返す (bytes.len は確保 capacity を返すため、文字列から数える)。
  float.from(list.len(bytes.to_list(bytes.from_string(s))))
}

@export(wasm, "ex_out_ptr")
fn ex_out_ptr() -> RawPtr = bytes.as_mut_ptr(g_out)

effect fn main() -> Unit = {
  let _c = ex_clamp(0.5)
  let _a = ex_in_alloc(1.0)
  let _r = ex_resolve()
  let _p = ex_out_ptr()
  ()
}
